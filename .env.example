# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commitar o arquivo ".env" (já está no .gitignore).

# ---- Banco de dados (Postgres) ----
POSTGRES_DB=gerenciamentoimoveispi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_use_uma_senha_forte

# ---- JWT ----
# Gere com: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_minimo_32_caracteres

# ---- Cloudflare R2 (armazenamento de arquivos) ----
# As chaves antigas vazaram no histórico do git: gere novas no painel do Cloudflare R2
# e revogue as antigas antes de ir pra produção.
CLOUDFLARE_R2_ACCESS_KEY=CHANGE_ME
CLOUDFLARE_R2_SECRET_KEY=CHANGE_ME
CLOUDFLARE_R2_BUCKET=documents-images
CLOUDFLARE_R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://CHANGE_ME.r2.dev

# ---- Domínio / HTTPS (Nginx + Let's Encrypt) ----
# Troque pelo domínio real apontado (DNS A record) para o IP público da instância EC2.
DOMAIN=example.com
EMAIL=admin@example.com
